@page "/menu"
@using PosReserva.Web.Data
@inject SiteTextService Texts
@inject DishService DishService

<PageTitle>La carta · Amaranta Gótico</PageTitle>

<section class="page-hero">
    <div class="container">
        <h1>@T("menu.hero.title")</h1>
        <p>@T("menu.hero.subtitle")</p>
    </div>
</section>

<section class="container page-section">
    @if (categories.Count > 0)
    {
        @foreach (var category in categories)
        {
            <div class="menu-category">
                <h2>@category.Name</h2>
                @foreach (var item in category.Items)
                {
                    <div class="menu-item">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" style="width:3.5rem;height:3.5rem;object-fit:cover;border-radius:0.4rem" />
                        }
                        <span>
                            @item.Title
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <br /><small>@item.Description</small>
                            }
                        </span>
                        @if (!string.IsNullOrWhiteSpace(item.PriceText))
                        {
                            <span class="menu-item__price">@item.PriceText</span>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="menu-category">
            <p>@T("menu.empty")</p>
        </div>
    }

    <div class="menu-category">
        <h2>@T("menu.groups.title")</h2>
        <div class="menu-item">
            <span>@T("menu.groups.line1")</span>
        </div>
        <div class="menu-item">
            <span>@T("menu.groups.line2")</span>
        </div>
        <div class="menu-item">
            <span>@T("menu.groups.line3")</span>
        </div>
        <a class="button" href="/grupos">@T("menu.groups.cta")</a>
    </div>
</section>

@code {
    private Dictionary<string, string> texts = new();
    private List<MenuCategory> categories = new();

    private string T(string key) => texts.TryGetValue(key, out var value) ? value : key;

    private sealed record MenuCategory(string Name, List<Dish> Items);

    protected override async Task OnInitializedAsync()
    {
        texts = await Texts.GetAsync();
        var dishes = await DishService.GetAllAsync();
        categories = dishes
            .GroupBy(d => d.Category, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group.Min(dish => dish.DisplayOrder))
            .Select(group => new MenuCategory(group.Key, group.OrderBy(dish => dish.DisplayOrder).ToList()))
            .ToList();
    }
}
