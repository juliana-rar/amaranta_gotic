@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 style="color: var(--color-danger)">Error.</h1>
<h2 style="color: var(--color-danger)">Se ha producido un error al procesar tu solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID de la solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar al entorno de <strong>Desarrollo</strong> mostrará información más detallada sobre el error producido.
</p>
<p>
    <strong>El entorno de Desarrollo no debe estar habilitado en aplicaciones desplegadas.</strong>
    Puede hacer que se muestre a los usuarios información sensible de las excepciones.
    Para depurar en local, habilita el entorno de <strong>Desarrollo</strong> estableciendo la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong>
    y reiniciando la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
