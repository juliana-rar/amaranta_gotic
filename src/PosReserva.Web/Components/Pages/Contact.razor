@page "/contacto"
@using PosReserva.Web.Data
@inject SiteTextService Texts
@inject SiteContentService ContentService

<PageTitle>Contacto · Amaranta Gótico</PageTitle>

<section class="page-hero">
    <div class="container">
        <h1>@T("contacto.hero.title")</h1>
        <p>@T("contacto.hero.text")</p>
        <p>@T("contacto.hero.groups").Replace("{phone}", content.ContactPhone)</p>
    </div>
</section>

<section class="container page-section">
    <div class="contact-cards">
        <div class="contact-card">
            <h3>@T("contacto.phone.label")</h3>
            <p><a href="tel:@content.ContactPhone.Replace(" ", "")">@content.ContactPhone</a></p>
        </div>
        <div class="contact-card">
            <h3>@T("contacto.email.label")</h3>
            <p><a href="mailto:@content.ContactEmail">@content.ContactEmail</a></p>
        </div>
        <div class="contact-card">
            <h3>@T("contacto.instagram.label")</h3>
            <p><a href="https://www.instagram.com/amarantagotico/" target="_blank" rel="noopener">@content.ContactInstagram</a></p>
        </div>
    </div>
</section>

@code {
    private Dictionary<string, string> texts = new();
    private SiteContent content = new();

    private string T(string key) => texts.TryGetValue(key, out var value) ? value : key;

    protected override async Task OnInitializedAsync()
    {
        texts = await Texts.GetAsync();
        content = await ContentService.GetAsync();
    }
}
