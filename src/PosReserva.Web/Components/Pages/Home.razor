@page "/"
@using PosReserva.Web.Data
@inject SiteTextService Texts
@inject SiteContentService ContentService
@inject DishService DishService
@inject TestimonialService TestimonialService
@inject GalleryService GalleryService

<PageTitle>Amaranta Gótico · Brasería en el Barrio Gótico</PageTitle>

<section class="hero">
    <div class="hero__bg" style="@HeroStyle"></div>
    <div class="hero__overlay"></div>
    <div class="container hero__inner">
        <span class="eyebrow hero__eyebrow">@content.HeroEyebrow</span>
        <h1>@content.HeroTitle</h1>
        <p>@content.HeroSubtitle</p>
        <div class="hero__actions">
            <a class="button" data-size="lg" href="/reservar">@T("home.hero.cta")</a>
            <a class="button" data-variant="outline" data-size="lg" href="/menu">@T("home.hero.secondary")</a>
        </div>
        <div class="hero__trust">
            <span class="hero__trust-item">@T("home.hero.trust1")</span>
            <span class="hero__trust-item">@T("home.hero.trust2")</span>
            <span class="hero__trust-item">@T("home.hero.trust3")</span>
        </div>
    </div>
</section>

<section class="menu-band">
    <div class="container">
        <h2 class="menu-band__title reveal">@T("home.menu.title")</h2>
        <div class="menu-band__grid stagger">
            @foreach (var category in MenuCategories)
            {
                <div class="menu-band__item reveal">
                    @if (!string.IsNullOrWhiteSpace(category.Image))
                    {
                        <div class="menu-band__circle"><img src="@category.Image" alt="@category.Title" /></div>
                    }
                    else
                    {
                        <div class="menu-band__circle" data-empty="true">@category.Fallback</div>
                    }
                    <h3>@category.Title</h3>
                    <p>@category.Description</p>
                </div>
            }
        </div>
        <div class="menu-band__cta reveal">
            <a class="button" data-size="lg" href="/menu">@T("home.menu.cta")</a>
        </div>
    </div>
</section>

<section class="features container stagger">
    <div class="feature-card reveal">
        <div class="feature-card__icon">@content.Feature1Icon</div>
        <h3>@content.Feature1Title</h3>
        <p>@content.Feature1Description</p>
    </div>
    <div class="feature-card reveal">
        <div class="feature-card__icon">@content.Feature2Icon</div>
        <h3>@content.Feature2Title</h3>
        <p>@content.Feature2Description</p>
    </div>
    <div class="feature-card reveal">
        <div class="feature-card__icon">@content.Feature3Icon</div>
        <h3>@content.Feature3Title</h3>
        <p>@content.Feature3Description</p>
    </div>
</section>

<section class="origin container stagger">
    <div class="origin__block reveal">
        <h2>@T("home.origin.heading1")</h2>
        <p>@content.StoryParagraph1</p>
    </div>
    <div class="origin__block reveal">
        <h2>@T("home.origin.heading2")</h2>
        <p>@content.StoryParagraph2</p>
    </div>
    <div class="origin__block reveal">
        <h2>@T("home.origin.heading3")</h2>
        <p>"@content.StoryQuote" — @content.StoryQuoteAuthor</p>
    </div>
</section>

<section class="ribbon">
    <a class="reveal" href="/reservar">@T("home.ribbon").Replace("{phone}", content.ContactPhone)</a>
</section>

<section class="break">
    <div class="hero__bg" style="@BreakStyle"></div>
    <div class="hero__overlay"></div>
    <div class="container break__inner reveal">
        <h2>@T("home.break.title")</h2>
        <a class="button" data-size="lg" href="/grupos">@T("home.break.cta")</a>
    </div>
</section>

@if (dishes.Count > 0)
{
    <section class="dish-showcase container">
        <div class="section-head reveal" data-align="center">
            <span class="eyebrow">@T("home.dishes.eyebrow")</span>
            <h2>@T("home.dishes.title")</h2>
        </div>
        <div class="dish-grid stagger">
            @foreach (var dish in dishes)
            {
                <div class="dish-card reveal">
                    @if (!string.IsNullOrWhiteSpace(dish.ImageUrl))
                    {
                        <div class="dish-card__image-wrap"><img src="@dish.ImageUrl" alt="@dish.Title" /></div>
                    }
                    else
                    {
                        <div class="dish-card__image-wrap" data-empty="true">🔥</div>
                    }
                    <div class="dish-card__body">
                        <h3>
                            @dish.Title
                            @if (!string.IsNullOrWhiteSpace(dish.PriceText))
                            {
                                <span class="menu-item__price">@dish.PriceText</span>
                            }
                        </h3>
                        <p>@dish.Description</p>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (galleryImages.Count > 0)
{
    <section class="gallery container">
        <div class="section-head reveal" data-align="center">
            <span class="eyebrow">@T("home.gallery.eyebrow")</span>
            <h2>@T("home.gallery.title")</h2>
        </div>
        <div class="reveal">
            <PhotoCarousel Images="galleryImages" @rendermode="InteractiveServer" />
        </div>
    </section>
}

@if (testimonials.Count > 0)
{
    <section class="testimonials container">
        <div class="section-head reveal" data-align="center">
            <span class="eyebrow">@T("home.testimonials.eyebrow")</span>
            <h2>@T("home.testimonials.title")</h2>
        </div>
        <div class="testimonial-grid stagger">
            @foreach (var testimonial in testimonials)
            {
                <div class="testimonial-card reveal">
                    <div class="testimonial-card__stars">★★★★★</div>
                    <p class="testimonial-card__quote">"@testimonial.Quote"</p>
                    <p class="testimonial-card__author">
                        <span class="testimonial-card__avatar">@testimonial.AuthorName.Substring(0, 1)</span>
                        @testimonial.AuthorName
                    </p>
                </div>
            }
        </div>
    </section>
}

<section class="stats">
    <div class="container stats__inner stagger">
        <div class="stats__item reveal">
            <span class="stats__number">@content.Stat1Number</span>
            <span class="stats__label">@content.Stat1Label</span>
        </div>
        <div class="stats__item reveal">
            <span class="stats__number">@content.Stat2Number</span>
            <span class="stats__label">@content.Stat2Label</span>
        </div>
        <div class="stats__item reveal">
            <span class="stats__number">@content.Stat3Number</span>
            <span class="stats__label">@content.Stat3Label</span>
        </div>
        <div class="stats__item reveal">
            <span class="stats__number">@content.Stat4Number</span>
            <span class="stats__label">@content.Stat4Label</span>
        </div>
    </div>
</section>

<section class="cta-banner">
    <div class="container cta-banner__inner reveal">
        <div>
            <h2>@T("home.cta.title")</h2>
            <p>@T("home.cta.text")</p>
        </div>
        <a class="button" data-size="lg" href="/grupos">@T("home.cta.button")</a>
    </div>
</section>

@code {
    private Dictionary<string, string> texts = new();
    private SiteContent content = new();
    private List<Dish> dishes = new();
    private List<Testimonial> testimonials = new();
    private List<GalleryImage> galleryImages = new();

    private string T(string key) => texts.TryGetValue(key, out var value) ? value : key;

    private sealed record MenuCategory(string Image, string Title, string Description, string Fallback);

    private List<MenuCategory> MenuCategories => new()
    {
        new(content.Category1Image, content.Category1Title, content.Category1Description, "🔥"),
        new(content.Category2Image, content.Category2Title, content.Category2Description, "🍚"),
        new(content.Category3Image, content.Category3Title, content.Category3Description, "🥘"),
        new(content.Category4Image, content.Category4Title, content.Category4Description, "🍸"),
    };

    private string HeroStyle
    {
        get
        {
            var image = galleryImages.ElementAtOrDefault(0)?.ImageUrl
                ?? dishes.FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.ImageUrl))?.ImageUrl;
            return string.IsNullOrWhiteSpace(image) ? "background-image: url('/images/amaranta-ambiente.jpg');" : $"background-image: url('{image}');";
        }
    }

    private string BreakStyle
    {
        get
        {
            var image = galleryImages.ElementAtOrDefault(1)?.ImageUrl
                ?? galleryImages.ElementAtOrDefault(0)?.ImageUrl
                ?? dishes.Skip(1).FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.ImageUrl))?.ImageUrl
                ?? dishes.FirstOrDefault(d => !string.IsNullOrWhiteSpace(d.ImageUrl))?.ImageUrl;
            return string.IsNullOrWhiteSpace(image) ? "background-image: url('/images/amaranta-brasa.jpg');" : $"background-image: url('{image}');";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        texts = await Texts.GetAsync();
        content = await ContentService.GetAsync();
        dishes = (await DishService.GetAllAsync()).Where(d => d.ShowOnHome).ToList();
        testimonials = await TestimonialService.GetAllAsync();
        galleryImages = await GalleryService.GetAllAsync();
    }
}
