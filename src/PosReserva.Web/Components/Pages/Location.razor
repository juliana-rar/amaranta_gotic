@page "/ubicacion"
@using PosReserva.Web.Data
@inject SiteTextService Texts
@inject SiteContentService ContentService
@inject BusinessHoursService HoursService

<PageTitle>Dónde estamos · Amaranta Gótico</PageTitle>

<section class="page-hero">
    <div class="container">
        <h1>@T("ubicacion.hero.title")</h1>
        <p>@T("ubicacion.hero.subtitle")</p>
    </div>
</section>

<section class="container page-section">
    <div class="info-grid">
        <div>
            <h2>@T("ubicacion.address.title")</h2>
            @foreach (var line in content.LocationAddress.Split('\n', StringSplitOptions.RemoveEmptyEntries))
            {
                <p>@line</p>
            }
            <p><a href="tel:@content.ContactPhone.Replace(" ", "")">@content.ContactPhone</a></p>
            <p>@T("ubicacion.transport")</p>
        </div>

        <div>
            <h2>@T("ubicacion.hours.title")</h2>
            <table class="hours-table">
                <tbody>
                    @foreach (var hour in hours)
                    {
                        <tr>
                            <td>@BusinessHoursService.DayNames[hour.DayOrder]</td>
                            <td>@BusinessHoursService.FormatShifts(hour)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private Dictionary<string, string> texts = new();
    private SiteContent content = new();
    private List<BusinessHour> hours = new();

    private string T(string key) => texts.TryGetValue(key, out var value) ? value : key;

    protected override async Task OnInitializedAsync()
    {
        texts = await Texts.GetAsync();
        content = await ContentService.GetAsync();
        hours = await HoursService.GetAllAsync();
    }
}
