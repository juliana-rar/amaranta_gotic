@page "/login"
@attribute [AllowAnonymous]
@layout PosReserva.Web.Components.Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · Pizzería del Puerto</PageTitle>

<div class="auth-card__brand">🍕 Pizzería del Puerto</div>
<h1>Iniciar sesión</h1>
<p>Accede al panel para editar el contenido de la web.</p>

<EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login" Enhance="false" class="admin-form">
    <DataAnnotationsValidator />

    @if (_error is not null)
    {
        <div class="field-error">@_error</div>
    }

    <div class="field">
        <label>Usuario</label>
        <InputText @bind-Value="Input.Username" class="input" autocomplete="username" />
        <ValidationMessage For="() => Input.Username" />
    </div>

    <div class="field">
        <label>Contraseña</label>
        <InputText type="password" @bind-Value="Input.Password" class="input" autocomplete="current-password" />
        <ValidationMessage For="() => Input.Password" />
    </div>

    <button class="button" type="submit">Entrar</button>
</EditForm>

<p class="auth-card__hint">¿No tienes cuenta? <a href="/register">Crear una con código de invitación</a></p>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] public LoginInput Input { get; set; } = new();
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string? _error;

    private async Task LoginUser()
    {
        var result = await Auth.LoginAsync(Input.Username.Trim(), Input.Password);
        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, result.User!.Id.ToString()),
            new(ClaimTypes.Name, result.User.Username)
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/admin" : ReturnUrl);
    }

    public class LoginInput
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
